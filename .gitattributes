# Normalize line endings across platforms (Rust + Node monorepo)
* text=auto eol=lf

# Binary assets - never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.wasm binary
*.pdf binary
*.zip binary
*.gz binary

# Keep Windows-only shell scripts usable
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
