# Local overrides for the jiuyue backend. Copy to `.env` — `.env` is gitignored.
#
# PORT=8080
# RUST_LOG=info
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/jiuyue
# JWT_SECRET=<至少 32 字节的随机串；缺失或过短会在启动时直接报错>
# ACCESS_TOKEN_TTL_SECS=900        # 15 分钟
# REFRESH_TOKEN_TTL_SECS=2592000   # 30 天
# APP_BASE_URL=http://localhost:5173   # 邮件里的验证/重置链接以此为前缀
# EMAIL_VERIFICATION_TTL_SECS=86400    # 验证链接 24 小时
# PASSWORD_RESET_TTL_SECS=3600         # 重置链接 1 小时
# SMTP_URL=                            # 留空；本构建无服务商，设置即拒绝启动
