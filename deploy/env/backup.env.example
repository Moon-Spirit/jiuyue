# jiuyue backup environment template.
#
# Installed by deploy/provision.sh to /etc/jiuyue/backup.env (mode 0640,
# root:root) and loaded by the jiuyue-backup.service systemd unit via
# EnvironmentFile=. Everything here is read by deploy/backup.sh and
# deploy/restore.sh.
#
# NEVER commit a filled-in copy: this is server state. This template carries
# placeholders only.
#
# WHAT IS *NOT* IN THIS FILE: the encryption passphrase. That lives in its own
# file (GPG_PASSPHRASE_FILE below), generated on the box and stored in the
# operator's password manager as well. If the passphrase is lost, every backup
# is unreadable. If it is on the same disk as the backups, the encryption is
# theatre.

# --- where backups go -------------------------------------------------------
#
# Local staging/retention directory on the box. Fast local disk; pruned to
# BACKUP_KEEP_LOCAL_DAYS. A local disk failure must not lose history, which is
# what the remote copy below is for.
BACKUP_DIR=/var/backups/jiuyue

# Off-box target. Either:
#   * an rclone remote, ideally a `rclone crypt` remote wrapping S3/R2/OSS, so
#     contents AND filenames are encrypted before they leave the machine
#     (placeholder below; real value stays on the server), or
#   * a plain directory path (useful for a mounted NAS, or in CI/tests).
# Upload uses `rclone copy`, never `sync`, so pruning locally can never delete
# remote history.
BACKUP_REMOTE=r2crypt:jiuyue-backups

# --- retention: two independent policies ------------------------------------
#
# Local and remote are separate on purpose. Local is short (cheap disk, and a
# local copy only helps with fat-finger deletes); remote is long (that is the
# copy that survives the box). Changing one MUST NOT touch the other.
BACKUP_KEEP_LOCAL_DAYS=7
BACKUP_KEEP_REMOTE_DAYS=30

# --- box layout (defaults match deploy/ and docs/deploy.md) -----------------
DATA_DIR=/var/lib/jiuyue
ENV_FILE=/etc/jiuyue/jiuyue.env
GPG_PASSPHRASE_FILE=/etc/jiuyue/backup_gpg_pass

# --- alerting ---------------------------------------------------------------
#
# Uptime Kuma "push" monitor URL (Monitor type: Push; heartbeat interval set to
# ~25h so a single missed night trips it). Every run pings status=up; any
# failure pings status=down. The failure that matters most is the backup that
# never ran — silence is the alert.
#
# Leave the placeholder until a monitor exists. An empty value disables the ping
# and a failed backup then alerts nobody; docs/backup.md §Alerting explains the
# monitor-side configuration.
HEARTBEAT_URL=https://kuma.example.com/api/push/REPLACE_WITH_PUSH_TOKEN

# --- tuning -----------------------------------------------------------------
# Serialise runs on this box so two overlapping backups cannot fight.
BACKUP_LOCK=/run/lock/jiuyue-backup.lock
