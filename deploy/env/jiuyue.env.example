# jiuyue backend environment template.
#
# Installed by deploy/provision.sh to /etc/jiuyue/jiuyue.env (mode 0640,
# owner root:jiuyue) and loaded by the systemd unit via EnvironmentFile=.
#
# NEVER commit the filled-in file: /etc/jiuyue/jiuyue.env is server state, and
# this template carries placeholders only.
#
# Variables below are the complete set the binary reads. Source of truth:
#   backend/crates/server/src/config.rs   (Config::from_env)
#   backend/.env.example
# The file's values win over any `.env` in the working directory.
#
# Secret handling: generate with a CSPRNG on the server, keep the only copies in
# /etc/jiuyue/ and in the operator's password manager, and let provision.sh
# rotate without ever echoing the value back to the terminal.

# --- required: the process refuses to start without these ------------------

# PostgreSQL connection string. Loopback + a dedicated least-privilege role.
# URL-encode any special characters in the password.
DATABASE_URL=postgres://jiuyue:REPLACE_ME_DB_PASSWORD@127.0.0.1:5432/jiuyue

# HS256 signing key. Must be at least 32 bytes; a shorter key is rejected when
# the token issuer is built. Generate on the server:
#   openssl rand -base64 48
JWT_SECRET=REPLACE_ME_openssl_rand_base64_48

# --- optional: defaults shown in parentheses -------------------------------

# TCP port the server binds (8080). The server listens on 0.0.0.0, so the
# firewall MUST block this port from the internet; only Caddy should reach it.
PORT=8080

# tracing-subscriber filter (info). Example while debugging:
#   RUST_LOG=jiuyue_server=debug,jiuyue_auth=debug,info
RUST_LOG=info

# Access-token lifetime, seconds (900 = 15 minutes).
ACCESS_TOKEN_TTL_SECS=900

# Refresh-token lifetime, seconds (2592000 = 30 days).
REFRESH_TOKEN_TTL_SECS=2592000

# Public origin the frontend is served from. Used to build the links inside the
# verification and password-reset emails, so it must be the address users
# actually reach (Caddy's site address), not the backend's bind address.
APP_BASE_URL=https://chat.example.com

# Email-verification link lifetime, seconds (86400 = 24 hours).
EMAIL_VERIFICATION_TTL_SECS=86400

# Password-reset link lifetime, seconds (3600 = 1 hour).
PASSWORD_RESET_TTL_SECS=3600

# Transactional-mail transport. LEAVE EMPTY: this build ships no provider, and
# setting a value makes the server refuse to start rather than accept
# registrations while every verification and reset link only reaches a log file.
# A deployment that wants real delivery supplies a Mailer implementation (see
# docs/adr/0015-email-verification-and-the-mailer-seam.md).
SMTP_URL=

# --- third-party sign-in (optional; see docs/adr/0016-third-party-sign-in.md) --

# A provider with no client id AND secret is simply absent from the login page —
# it is never offered and broken. Set both halves of a pair or neither.
#
# The secret is server-only; the client id is public by definition and is what
# the browser's authorization URL carries. Nothing else about a provider is
# configurable: the endpoints and scopes are code (jiuyue_auth::oauth::provider).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google: create an OAuth 2.0 Client ID of type "Web application" and register
# the redirect URI below as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Origin a provider sends the browser back to. Defaults to APP_BASE_URL, which is
# right whenever the app and the callback share an origin. Set it only when the
# callback terminates on a different host; it is never taken from a request
# header. The provider must be registered with "<this>/auth/oauth/callback".
OAUTH_CALLBACK_BASE_URL=
